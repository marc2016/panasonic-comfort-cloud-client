{
    "transform": {
        "^.+\\.(t|j)sx?$": ["ts-jest", {
            "diagnostics": {
                "ignoreCodes": [151002]
            }
        }]
    },
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
    "modulePathIgnorePatterns": [
        "<rootDir>/dist/"
    ],
    "moduleFileExtensions": [
        "ts",
        "tsx",
        "js",
        "jsx",
        "json",
        "node"
    ],
    "moduleNameMapper": {
        "^axios-cookiejar-support$": "<rootDir>/test/__mocks__/axios-cookiejar-support.ts",
        "^(\\.{1,2}/.*)\\.js$": "$1"
    }
}